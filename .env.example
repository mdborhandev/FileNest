APP_NAME=FileNest API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:fahim123@localhost:5432/filenest_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

JWT_SECRET_KEY=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-refresh-token-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

DEBUG=False
